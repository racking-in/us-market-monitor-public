# Copy to .env on the cloud host and fill in real values.
EMAIL_PROVIDER=smtp
EMAIL_FROM=your_sender@example.com
EMAIL_TO=your_receiver@example.com

# SMTP option
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password_or_app_password
SMTP_USE_SSL=false

# Resend option (set EMAIL_PROVIDER=resend)
RESEND_API_KEY=
